{
  "task": "optimization",
  "data": {
    "input_column": "canonical",
    "response_column": "molwt",
    "training_dataset_file": "tests/data/DRD2/subset-50/train.csv",
    "covariate_column": "activity"
  },
  "descriptors": [
    {
      "name": "SmilesFromFile",
      "parameters": {
      }
    }
  ],
  "settings": {
    "mode": "regression",
    "n_splits": 5,
    "n_replicates": 1,
    "direction": "maximize",
    "n_trials": 1,
