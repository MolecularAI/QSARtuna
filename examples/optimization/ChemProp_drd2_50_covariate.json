  },
  "algorithms": [
    {
      "name": "ChemPropRegressor",
      "parameters": {
        "aggregation_norm": {
          "low": 100,
          "high": 100
        },
        "batch_size": [64],
        "ensemble_size": 1,
        "epochs": 1,
        "depth": {
          "low": 2,
          "high": 6
        },
        "trial_dropout": 1,
        "ffn_hidden_dim": {
          "low": 300,
          "high": 2400
        },
        "ffn_num_layers": {
          "low": 1,
          "high": 3
