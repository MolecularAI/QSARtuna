{
  "task": "optimization",
  "data": {
    "input_column": "canonical",
    "response_column": "molwt_gt_330",
    "training_dataset_file": "tests/data/DRD2/subset-50/train.csv",
    "test_dataset_file": "tests/data/DRD2/subset-50/train.csv"
  },
  "descriptors": [
    { "name": "ScaledMordredDescriptors",
      "parameters": {
        "feature_names": ["ABC", "ABCGG", "MDEN-22", "MDEN-23", "MDEN-33"]
      }
    }
  ],
  "settings": {
    "mode": "classification",
    "n_splits": 5,
    "shuffle": true,
    "direction": "maximize",
    "n_trials": 15,
    "n_jobs": 1
  },
  "algorithms":
  [
    { "name": "RandomForestClassifier",
      "parameters": {
        "max_depth": {
          "low": 10,
          "high": 20
        },
        "n_estimators": {
          "low": 10,
          "high": 100
        },
        "max_features": ["sqrt", "log2"]
      }
    },
    {
      "name": "KNeighborsClassifier",
      "parameters": {
        "n_neighbors": {
          "low": 1,
          "high": 3
        },
        "weights": ["uniform", "distance"],
        "metric": ["minkowski", "euclidean", "manhattan"]
      }
    },
    { "name": "SVC",
      "parameters": {
        "C": {
          "low": 1e-7,
          "high": 1e7
        },
        "gamma": {
          "low": 1e-9,
          "high": 1000
        }
      }
    }
  ]
}

