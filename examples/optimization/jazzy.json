{
  "task": "optimization",
  "data": {
    "input_column": "canonical",
    "response_column": "molwt",
    "training_dataset_file": "tests/data/DRD2/subset-50/train_with_errors.csv"
  },
  "descriptors": [
    {
      "name": "JazzyDescriptors",
      "parameters": {
        "jazzy_filters": {
          "NumHAcceptors": 10,
          "NumHDonors": 10,
          "MolWt": 1000
        },
        "embedding_type": "3D",
        "embedding_max_iterations": 2,
        "embedding_seed": 24
      }
    }
  ],
  "settings": {
    "mode": "regression",
    "n_splits": 2,
    "shuffle": true,
    "direction": "maximize",
    "n_trials": 2,
    "random_seed": 2,
    "n_jobs": -1
  },
  "algorithms": [
    {
      "name": "RandomForestRegressor",
      "parameters": {
        "max_depth": {
          "low": 10,
          "high": 20
        },
        "n_estimators": {
          "low": 2,
          "high": 2
        },
        "max_features": [
          "auto",
          "sqrt",
          "log2"
        ]
      }
    }
  ]
}
